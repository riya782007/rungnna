{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2021", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "resolveJsonModule": true, "isolatedModules": true, "types": ["vite/client", "vite-plugin-pwa/client"]
